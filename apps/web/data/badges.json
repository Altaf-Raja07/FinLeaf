{
  "$comment": [
    "Badge definitions.",
    "",
    "A badge is awarded by the rules in lib/badges when the user's real",
    "activity satisfies the criteria. They are never granted directly, so a",
    "badge always reflects something that actually happened.",
    "",
    "  slug       - stable key",
    "  icon       - name from the icon set used by src/components/Icon.tsx",
    "  criteria   - the rule, interpreted by lib/badges.awardable()",
    "  translations[locale] = { name, description }",
    "",
    "Criteria types:",
    "  lesson_completed       -> criteria.lesson = lesson slug",
    "  category_complete      -> criteria.category, criteria.count = all lessons in it",
    "  total_lessons          -> criteria.count",
    "  quiz_score             -> criteria.minPct on a single attempt",
    "  goal_created           -> criteria.count",
    "  goal_completed         -> criteria.count",
    "  transaction_count      -> criteria.count",
    "  offset_contributions   -> criteria.count",
    "  green_points           -> criteria.threshold",
    "  trust_score            -> criteria.threshold",
    "  voucher_redeemed       -> criteria.count",
    "  days_active            -> criteria.count"
  ],
