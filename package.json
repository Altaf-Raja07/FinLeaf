{
  "name": "finleaf",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:migrate": "node db/migrate.mjs",
    "db:status": "node db/migrate.mjs --status",
    "db:seed": "node db/seed.mjs",
    "db:reseed": "node db/seed.mjs --force",
    "db:reset": "node db/seed.mjs --force",
    "ml:setup": "bash ml/scripts/setup_venv.sh",
    "ml:train": "ml/.venv/bin/python ml/scripts/train.py",
    "ml:check": "ml/.venv/bin/python ml/scripts/sanity_check.py",
    "ml:serve": "ml/.venv/bin/python ml/service.py",
    "db:psql": "psql postgres://finleaf:finleaf_local_dev@127.0.0.1:55432/finleaf",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/",
    "qa:visual": "node scripts/visual-qa.mjs",
    "qa:visual:mobile": "node scripts/visual-qa.mjs --mobile"
  },
  "dependencies": {
    "@types/pg": "^8.23.1",
    "dotenv": "^17.4.2",
    "next": "16.3.8",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "playwright": "^1.63.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "description": "FinLeaf - digital banking for financial inclusion and sustainability (simulated prototype)"
}
