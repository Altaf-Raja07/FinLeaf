# FinLeaf local configuration.
#
# Copy to .env for development:  cp .env.example .env
# Everything here is a LOCAL DEVELOPMENT value. Never commit a filled-in .env,
# and never place a real credential in this file.

# --- PostgreSQL -------------------------------------------------------------
# Matches the service in docker-compose.yml.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432
POSTGRES_USER=finleaf
POSTGRES_PASSWORD=finleaf_local_dev
POSTGRES_DB=finleaf

# --- Application ------------------------------------------------------------
# Signs session cookies. Replace with a long random value outside local dev.
SESSION_SECRET=dev-only-change-me
# Session lifetime in days.
SESSION_TTL_DAYS=7

# --- Demo authentication ----------------------------------------------------
# The prototype's OTP is fixed and displayed in the UI. This is NOT an SMS
# integration and no message is ever sent.
DEMO_OTP=123456

# --- ML service -------------------------------------------------------------
# Optional. When the service is unreachable the app falls back to its built-in
# scoring logic and says so in the response, rather than failing the request.
ML_SERVICE_URL=http://127.0.0.1:8000
ML_ENABLED=true
ML_TIMEOUT_MS=3000

# --- Optional spend-based emissions API -------------------------------------
# Leave empty to use the static factor table only. The key is read on the
# server and is never sent to the browser.
CLIMATIQ_API_KEY=
CLIMATIQ_API_URL=https://api.climatiq.io
