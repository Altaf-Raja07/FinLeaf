# ---------------------------------------------------------------------------
# FinLeaf — docker compose environment
# Copy to `.env` in the repository root and fill in before `docker compose up`.
# These values are injected into the containers; they are NOT the same file as
# apps/web/.env, which the Next.js process reads directly during local
# development outside Docker.
# ---------------------------------------------------------------------------

POSTGRES_USER=finleaf
POSTGRES_PASSWORD=change-me
POSTGRES_DB=finleaf
POSTGRES_PORT=5432

WEB_PORT=3000
ML_PORT=8000

# REQUIRED. 32+ random bytes: openssl rand -base64 32
APP_SECRET=
# REQUIRED. Public https origin of the deployment.
APP_URL=

# OTP delivery. `console` is refused by apps/web when NODE_ENV=production, and
# the `web` container always runs in production mode.
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

MSG91_AUTH_KEY=
MSG91_SENDER_ID=FINLEA
MSG91_TEMPLATE_ID=

# Optional spend-based emission API.
CLIMATIQ_API_KEY=

DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en,hi,kn
LOG_LEVEL=info
ML_LOG_LEVEL=INFO
